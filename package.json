{
  "name": "galaxia-camisetas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "check:source": "node scripts/source-check.mjs",
    "check:environment": "node scripts/check-environment.mjs"
  },
  "dependencies": {
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "pg": "^8.16.3",
    "zod": "^4.1.13",
    "lucide-react": "^0.562.0",
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/titan-one": "^5.2.0",
    "@next/env": "^16.0.10"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.57.0"
  }
}
